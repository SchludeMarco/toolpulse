rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Tools: für alle angemeldeten Nutzer lesbar, nur die Cloud Function
    // (Admin-SDK, umgeht Rules) darf schreiben.
    match /tools/{toolId} {
      allow read: if true;
      allow write: if false;
    }

    // Kuratierungs-Protokoll: nur lesbar, kein Client-Schreibzugriff.
    match /curationRuns/{runId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Nutzer dürfen ausschließlich ihre eigenen Einstellungen/Merklisten lesen/schreiben.
    match /userPreferences/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /favorites/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Push-Tokens fürs "Tool des Tages": Nutzer verwalten nur ihre eigenen;
    // die Cloud Function (Admin-SDK) liest alle, um Benachrichtigungen zu
    // versenden, und umgeht dabei diese Regeln.
    match /pushSubscriptions/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
